# Copy this file to .env and fill in your values

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sltripplanner

# Secret key used to sign JWTs — use a long random string in production
JWT_SECRET=your-long-random-secret-here

# The URL of your frontend app — used for CORS
# Local dev: http://localhost:5173
# Production: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# Port for the Express server (optional — defaults to 5000)
PORT=5000

# Admin account created by the seed script (node seed.js)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@sltripplanner.lk
ADMIN_PASSWORD=Admin@1234
